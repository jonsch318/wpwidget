// Merge this module into ~/.config/waybar/config.jsonc and add
// "custom/wpwidget" to your existing modules-right (or another module list).
// Remove the built-in "wireplumber" entry to avoid duplicate audio controls.
{
  "modules-right": ["custom/wpwidget"],
  "custom/wpwidget": {
    "exec": "$HOME/.local/bin/wpwidget status",
    "return-type": "json",
    "escape": true,
    "interval": 1,
    "format": "{icon}  {text}",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "muted": " ",
      "unavailable": " ",
      "default": [" ", " ", " "]
    },
    "tooltip": true,
    "on-click": "$HOME/.local/bin/wpwidget popup",
    "on-click-right": "$HOME/.local/bin/wpwidget mute",
    "on-click-middle": "$HOME/.local/bin/wpwidget mute --kind input",
    "on-scroll-up": "$HOME/.local/bin/wpwidget volume up --step 5",
    "on-scroll-down": "$HOME/.local/bin/wpwidget volume down --step 5",
    "smooth-scrolling-threshold": 1,
    "exec-on-event": false
  }
}
