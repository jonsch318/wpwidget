// Optional separate microphone module; add "custom/wpwidget-input" to a module list.
{
  "custom/wpwidget-input": {
    "exec": "$HOME/.local/bin/wpwidget status --kind input",
    "return-type": "json",
    "escape": true,
    "interval": 1,
    "format": "{icon}  {text}",
    "format-icons": {
      "muted": "",
      "unavailable": "",
      "default": ""
    },
    "on-click": "$HOME/.local/bin/wpwidget popup",
    "on-click-right": "$HOME/.local/bin/wpwidget mute --kind input",
    "on-scroll-up": "$HOME/.local/bin/wpwidget volume up --kind input --step 5",
    "on-scroll-down": "$HOME/.local/bin/wpwidget volume down --kind input --step 5",
    "smooth-scrolling-threshold": 1,
    "exec-on-event": false
  }
}
